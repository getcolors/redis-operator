{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "{{namespace}}"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "colors-redis-operator",
        "namespace": "{{namespace}}"
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "colors-redis-operator",
        "namespace": "{{namespace}}"
      },
      "rules": [
        {
          "apiGroups": [
            "colors.getcolors.ai"
          ],
          "resources": [
            "redisdeployments",
            "redisdeployments/status",
            "redisdeployments/finalizers"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "patch",
            "update"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "colors-redis-operator",
        "namespace": "{{namespace}}"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "colors-redis-operator"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "colors-redis-operator",
          "namespace": "{{namespace}}"
        }
      ]
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "colors-redis-operator",
        "namespace": "{{namespace}}"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "5Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "colors-redis-operator",
        "namespace": "{{namespace}}"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "colors-redis-operator"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "colors-redis-operator"
            }
          },
          "spec": {
            "containers": [
              {
                "args": [
                  "{{namespace}}"
                ],
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "redis-credentials"
                    }
                  }
                ],
                "image": "{{image}}",
                "name": "controller",
                "resources": {
                  "limits": {
                    "memory": "2Gi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "volumeMounts": [
                  {
                    "mountPath": "/data",
                    "name": "state"
                  },
                  {
                    "mountPath": "/root/.ssh",
                    "name": "state",
                    "subPath": "ssh"
                  },
                  {
                    "mountPath": "/root/.gitlibs",
                    "name": "state",
                    "subPath": "gitlibs"
                  },
                  {
                    "mountPath": "/root/.m2",
                    "name": "state",
                    "subPath": "m2"
                  },
                  {
                    "mountPath": "/root/.deps.clj",
                    "name": "state",
                    "subPath": "deps-clj"
                  },
                  {
                    "mountPath": "/app/.cpcache",
                    "name": "state",
                    "subPath": "cpcache"
                  }
                ]
              }
            ],
            "serviceAccountName": "colors-redis-operator",
            "terminationGracePeriodSeconds": 10800,
            "volumes": [
              {
                "name": "state",
                "persistentVolumeClaim": {
                  "claimName": "colors-redis-operator"
                }
              }
            ]
          }
        }
      }
    }
  ],
  "kind": "List"
}
